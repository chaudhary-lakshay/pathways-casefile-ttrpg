<?xml version="1.0" encoding="utf-8"?>
<!-- The window background shown between process start and Compose's first
     frame: CaseFile's paper. There is one scheme and it is light only, so
     the first frame matches the app exactly in every mode. -->
<resources>
    <color name="launch_background">#FFF3EFE6</color>
    <!-- The launcher icon's background layer, and it is load-bearing rather
         than decorative: the foreground is black ink whose white line-work was
         keyed to transparent, so this colour is what shows through the Fool's
         eyes and spirals. On a dark surface those holes would disappear and the
         mark would read as a blob, so it is parchment. Deliberately NOT
         night-qualified, and deliberately NOT tied to the theme: a launcher
         icon looks the same whichever mode the phone is in. -->
    <color name="ic_launcher_background">#FFE2D3CF</color>
</resources>
